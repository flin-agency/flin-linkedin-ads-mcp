# Direct login: configure your own LinkedIn Developer app (never send secrets in chat).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:9876/callback
# Optional token store override; use a private path outside this repository.
# LINKEDIN_TOKEN_FILE=/absolute/private/path/tokens.json
# Legacy static token (optional when using OAuth):
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202603
LINKEDIN_RESTLI_PROTOCOL_VERSION=2.0.0
LINKEDIN_TIMEOUT_SECONDS=30
LINKEDIN_MAX_RETRIES=3
RUN_LIVE_LINKEDIN_TESTS=0
